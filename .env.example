# Docker image pushed by GitHub Actions (replace GITHUB_USERNAME with your GitHub username)
API_IMAGE=ghcr.io/GITHUB_USERNAME/r99-shop-api:latest

# PostgreSQL
DB_NAME=r99_shop_db
DB_USER=r99user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=r99-shop

# JWT (generate a strong random base64 string, min 32 chars)
JWT_SECRET=CHANGE_ME_VERY_LONG_SECRET_KEY_AT_LEAST_32_CHARS
JWT_EXPIRATION=86400000
